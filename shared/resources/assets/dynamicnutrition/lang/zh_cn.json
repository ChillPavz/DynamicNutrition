  "text.autoconfig.dynamicnutrition.title": "动态营养",
  "text.autoconfig.dynamicnutrition.category.default": "选项",
  "text.autoconfig.dynamicnutrition.option.hudEnabled": "HUD上的营养条",
  "text.autoconfig.dynamicnutrition.option.hudEnabled.@Tooltip": "在饥饿值上方显示一条紧凑的五色营养条。",
  "text.autoconfig.dynamicnutrition.option.hudOffsetX": "HUD营养条，水平偏移",
  "text.autoconfig.dynamicnutrition.option.hudOffsetX.@Tooltip": "如果其他模组已占用该位置，可将营养条左右移动，单位为像素。",
  "text.autoconfig.dynamicnutrition.option.hudOffsetY": "HUD营养条，垂直偏移",
  "text.autoconfig.dynamicnutrition.option.hudOffsetY.@Tooltip": "将营养条上下移动，单位为像素。负数为向上。",
  "text.autoconfig.dynamicnutrition.option.buttonEnabled": "物品栏按钮",
  "text.autoconfig.dynamicnutrition.option.buttonEnabled.@Tooltip": "在物品栏中显示一个打开营养界面的小按钮。无论是否显示，快捷键都可使用。",
  "text.autoconfig.dynamicnutrition.option.buttonOffsetX": "物品栏按钮，水平偏移",
  "text.autoconfig.dynamicnutrition.option.buttonOffsetX.@Tooltip": "如果按钮与其他模组的按钮重叠，可将其左右移动，单位为像素。",
  "text.autoconfig.dynamicnutrition.option.buttonOffsetY": "物品栏按钮，垂直偏移",
  "text.autoconfig.dynamicnutrition.option.buttonOffsetY.@Tooltip": "将按钮上下移动，单位为像素。负数为向上。",
  "text.autoconfig.dynamicnutrition.option.tooltipEnabled": "食物提示中的营养素",
  "text.autoconfig.dynamicnutrition.option.tooltipEnabled.@Tooltip": "在每个食物的提示中添加一行，显示它的营养价值。按住F3和H可查看数值的来源。",
  "text.autoconfig.dynamicnutrition.option.effectsEnabled": "营养素效果",
  "text.autoconfig.dynamicnutrition.option.effectsEnabled.@Tooltip": "让每种营养素拥有各自的效果：高于绿线时一种，低于红线时一种。碳水对应迅捷或缓慢，蛋白质对应力量或虚弱，脂肪对应抗性提升或饥饿，维生素对应生命恢复或失明，矿物质对应急迫或挖掘疲劳。所有增益显示为营养良好，所有减益显示为营养不良；在物品栏中悬停即可查看具体效果。无论是否开启，营养条都会照常变化。",
  "text.autoconfig.dynamicnutrition.option.announceStatusChanges": "播报状态变化",
  "text.autoconfig.dynamicnutrition.option.announceStatusChanges.@Tooltip": "当你的整体状态改变时在动作栏上提示，并说明是哪种营养素导致的。",
  "tooltip.dynamicnutrition.variety": "最近吃过，价值%s%%",
  "text.autoconfig.dynamicnutrition.option.varietyEnabled": "多样性很重要",
  "text.autoconfig.dynamicnutrition.option.varietyEnabled.@Tooltip": "反复吃同一种食物获得的营养会减少。饥饿值不受影响。",
  "text.autoconfig.dynamicnutrition.option.varietyWindow": "记住的餐数",
  "text.autoconfig.dynamicnutrition.option.varietyWindow.@Tooltip": "计算重复时考虑最近多少餐。数值越大越严格。",
  "text.autoconfig.dynamicnutrition.option.varietyPenaltyPercent": "重复惩罚",
  "text.autoconfig.dynamicnutrition.option.varietyPenaltyPercent.@Tooltip": "每次重复会让一餐损失多少，以百分比表示。",
  "text.autoconfig.dynamicnutrition.option.varietyFloorPercent": "一餐的最低价值",
  "text.autoconfig.dynamicnutrition.option.varietyFloorPercent.@Tooltip": "重复的食物永远不会低于这个百分比，因此只有一种食物来源也不会走投无路。",
  "screen.dynamicnutrition.effect_above": "§a高于%s：%s",
  "screen.dynamicnutrition.effect_below": "§c低于%s：%s",
  "text.autoconfig.dynamicnutrition.option.showEffectsOnHud": "在HUD上显示",
  "text.autoconfig.dynamicnutrition.option.showEffectsOnHud.@Tooltip": "在屏幕右上角的效果图标中显示营养良好和营养不良。只影响你自己；隐藏时效果仍然生效。",
  "text.autoconfig.dynamicnutrition.option.showEffectsInInventory": "在物品栏中显示",
  "text.autoconfig.dynamicnutrition.option.showEffectsInInventory.@Tooltip": "在物品栏旁的列表中显示营养良好和营养不良，悬停其上可列出它所代表的效果。只影响你自己；隐藏时效果仍然生效。",
  "text.autoconfig.dynamicnutrition.option.speedPercent": "迅捷强度",
  "text.autoconfig.dynamicnutrition.option.speedPercent.@Tooltip": "碳水高于绿线时迅捷的强度，以原版迅捷 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.slownessPercent": "缓慢强度",
  "text.autoconfig.dynamicnutrition.option.slownessPercent.@Tooltip": "碳水低于红线时缓慢的强度，以原版缓慢 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.strengthPercent": "力量强度",
  "text.autoconfig.dynamicnutrition.option.strengthPercent.@Tooltip": "蛋白质高于绿线时力量的强度，以原版力量 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.weaknessPercent": "虚弱强度",
  "text.autoconfig.dynamicnutrition.option.weaknessPercent.@Tooltip": "蛋白质低于红线时虚弱的强度，以原版虚弱 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.resistancePercent": "抗性提升强度",
  "text.autoconfig.dynamicnutrition.option.resistancePercent.@Tooltip": "脂肪高于绿线时抗性提升的强度，以原版抗性提升 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.hungerPercent": "饥饿强度",
  "text.autoconfig.dynamicnutrition.option.hungerPercent.@Tooltip": "脂肪低于红线时饥饿的强度，以原版饥饿 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.regenerationPercent": "生命恢复强度",
  "text.autoconfig.dynamicnutrition.option.regenerationPercent.@Tooltip": "维生素高于绿线时生命恢复的强度，以原版生命恢复 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.blindnessPercent": "失明强度",
  "text.autoconfig.dynamicnutrition.option.blindnessPercent.@Tooltip": "维生素低于红线时失明的强度，以原版失明 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.hastePercent": "急迫强度",
  "text.autoconfig.dynamicnutrition.option.hastePercent.@Tooltip": "矿物质高于绿线时急迫的强度，以原版急迫 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.option.miningFatiguePercent": "挖掘疲劳强度",
  "text.autoconfig.dynamicnutrition.option.miningFatiguePercent.@Tooltip": "矿物质低于红线时挖掘疲劳的强度，以原版挖掘疲劳 I 的百分比表示。100为完整效果，50为一半，0为关闭。",
  "text.autoconfig.dynamicnutrition.category.hud": "HUD",
  "text.autoconfig.dynamicnutrition.category.inventory": "物品栏",
  "text.autoconfig.dynamicnutrition.category.variety": "多样性",
  "text.autoconfig.dynamicnutrition.category.effects": "效果"
}
